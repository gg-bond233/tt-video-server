<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ggbond.ttvideo.mapper.VideoMapper">


    <!-- 评论 VO ResultMap（顶级评论，replies 通过子查询填充） -->
    <resultMap id="CommentVOResultMap" type="cn.ggbond.ttvideo.model.vo.CommentVO">
        <id column="commentId" property="commentId"/>
        <result column="userId" property="userId"/>
        <result column="username" property="username"/>
        <result column="userAvatar" property="userAvatar"/>
        <result column="replyToUsername" property="replyToUsername"/>
        <result column="content" property="content"/>
        <result column="createTime" property="createTime"/>
        <result column="likeCount" property="likeCount"/>
        <!-- 子查询：按父评论 id 查回复列表 -->
        <collection property="replies" ofType="cn.ggbond.ttvideo.model.vo.CommentVO"
                    select="findRepliesByParentId" column="commentId"/>
    </resultMap>


    <!-- 视频详情 ResultMap（含评论列表） -->
    <resultMap id="VideoDetailVOResultMap" type="cn.ggbond.ttvideo.model.vo.VideoDetailVO">
        <id column="videoId" property="videoId"/>
        <result column="videoName" property="videoName"/>
        <result column="uploaderName" property="uploaderName"/>
        <result column="category" property="category"/>
        <result column="intro" property="intro"/>
        <result column="duration" property="duration"/>
        <result column="thumbnailUrl" property="thumbnailUrl"/>
        <result column="videoUrl" property="videoUrl"/>
        <result column="releaseTime" property="releaseTime"/>
        <collection property="comments" resultMap="CommentVOResultMap"/>
    </resultMap>

    <!-- 查询视频详情（含评论列表） -->
    <!-- 查询视频详情（仅顶级评论 parent_id IS NULL，回复通过子查询装载） -->
    <select id="getVideoDetailById" resultMap="VideoDetailVOResultMap">
        SELECT v.id            AS videoId,
               v.name          AS videoName,
               v.uploader_name AS uploaderName,
               v.category      AS category,
               v.intro         AS intro,
               v.duration      AS duration,
               v.thumbnail_url AS thumbnailUrl,
               v.video_url     AS videoUrl,
               v.release_time  AS releaseTime,
               c.id            AS commentId,
               c.content       AS content,
               c.create_time   AS createTime,
               c.like_count    AS likeCount,
               u.username      AS username,
               u.user_avatar   AS userAvatar
        FROM tb_video v
                 LEFT JOIN tb_comment c ON v.id = c.video_id AND c.parent_id IS NULL
                 LEFT JOIN tb_user u ON c.user_id = u.id
        WHERE v.id = #{videoId}
        ORDER BY c.create_time DESC
    </select>

    <!-- 按父评论 id 查询回复列表（含回复者与被回复者用户名） -->
    <select id="findRepliesByParentId" resultType="cn.ggbond.ttvideo.model.vo.CommentVO">
        SELECT
            c.id            AS commentId,
            c.user_id       AS userId,
            c.content       AS content,
            c.create_time   AS createTime,
            c.like_count    AS likeCount,
            u.username      AS username,
            u.user_avatar   AS userAvatar,
            ru.username     AS replyToUsername
        FROM tb_comment c
                 LEFT JOIN tb_user u  ON c.user_id = u.id
                 LEFT JOIN tb_user ru ON c.reply_to_user_id = ru.id
        WHERE c.parent_id = #{parentId}
        ORDER BY c.create_time ASC
    </select>

    <!-- 根据视频 id 列表分页查询视频（按传入 id 顺序排序） -->
    <select id="getVideosByIds"  resultType="cn.ggbond.ttvideo.model.vo.VideoVO">
            SELECT     v.id            AS videoId,
                       v.name          AS videoName,
                       v.uploader_name AS uploaderName,
                       v.category      AS category,
                       v.duration      AS duration,
                       v.thumbnail_url AS thumbnailUrl,
                       v.video_url     AS videoUrl,
                       v.release_time  AS releaseTime
            FROM tb_video v
            WHERE v.id IN
        <foreach collection="videoIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY FIELD(v.id
        <foreach collection="videoIds" item="id">
            , #{id}
        </foreach>
        )
    </select>
</mapper>